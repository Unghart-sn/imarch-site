  function adjustCards() {
    if (window.innerWidth > 768) return;
    const openDetails = document.querySelectorAll('details.imarch-module[open]');
    if (!openDetails.length) return;
    openDetails.forEach(detail => {
      const cards = detail.querySelectorAll('.dc-card');
      cards.forEach(card => {
        card.style.width = '100%';
        card.style.maxWidth = '100%';
        card.style.minWidth = '0';
        card.style.boxSizing = 'border-box';
        const links = card.querySelectorAll('.dc-links, .dc-button');
        links.forEach(link => {
          if (link.classList && link.classList.contains('dc-links')) {
            link.style.flexDirection = 'column';
            link.style.gap = '0.5rem';
          }
          if (link.classList && link.classList.contains('dc-button')) {
            link.style.width = '100%';
            link.style.whiteSpace = 'normal';
            link.style.textAlign = 'center';
            link.style.margin = '0';
            link.style.padding = '0.5rem 0.8rem';
            link.style.fontSize = '0.75rem';
          }
        });
      });
    });
  }

  // Запускаем при загрузке
  document.addEventListener('DOMContentLoaded', adjustCards);
  // Запускаем при каждом клике (чтобы поймать открытие аккордеона)
  document.addEventListener('click', function(e) {
    if (e.target.closest('details.imarch-module summary')) {
      setTimeout(adjustCards, 50);
    }
  });
  // Запускаем при изменении размера окна
  window.addEventListener('resize', adjustCards);
})();
</script>

&nbsp;

